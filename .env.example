# ============================================================================
# AI Receptionist System - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control

# ============================================================================
# MongoDB Configuration
# ============================================================================

# MongoDB connection string
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DB_NAME=ai_receptionist

# Connection pool settings
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# Connection timeout (milliseconds)
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Google Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here

# Model selection
# Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
MODEL_NAME=gemini-2.0-flash-exp

# Model parameters
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TOP_P=0.95
LLM_TOP_K=40

# ============================================================================
# Routing Configuration
# ============================================================================

# Confidence thresholds
# High: Auto-route to next tier (recommended: 0.75-0.85)
CONFIDENCE_THRESHOLD_HIGH=0.75

# Medium: Ask clarification before routing (recommended: 0.4-0.6)
CONFIDENCE_THRESHOLD_MEDIUM=0.4

# Low: Escalate to human (< MEDIUM threshold)

# Maximum clarification attempts before escalation
MAX_CLARIFICATIONS=2

# ============================================================================
# Session Management
# ============================================================================

# Session time-to-live (minutes)
# How long sessions remain active without activity
SESSION_TTL_MINUTES=30

# Maximum conversation history to retain
# Reduces token usage for long conversations
MAX_CONVERSATION_HISTORY=10

# Session cleanup interval (minutes)
# How often to clean up expired sessions
SESSION_CLEANUP_INTERVAL_MINUTES=5

# ============================================================================
# Server Configuration
# ============================================================================

# Server host and port
HOST=0.0.0.0
PORT=8000

# Number of worker processes (production)
WORKERS=4

# Worker class for Uvicorn
WORKER_CLASS=uvicorn.workers.UvicornWorker

# Request timeout (seconds)
TIMEOUT=120

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/ai_receptionist.log

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Enable console logging
LOG_CONSOLE=true

# Enable structured JSON logging
LOG_JSON_FORMAT=true

# ============================================================================
# Telemetry & Monitoring
# ============================================================================

# Enable metrics collection
METRICS_ENABLED=true

# Metrics retention (hours)
METRICS_RETENTION_HOURS=168  # 1 week

# Enable Prometheus endpoint
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Sentry error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Rate Limiting
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per minute per IP
RATE_LIMIT_PER_IP=100

# Requests per minute per session
RATE_LIMIT_PER_SESSION=20

# Analytics endpoint rate limit
RATE_LIMIT_ANALYTICS=60

# ============================================================================
# Security & PII Protection
# ============================================================================

# Enable PII masking in logs
PII_MASKING_ENABLED=true

# Fields to mask (comma-separated)
PII_MASK_FIELDS=phone,email,ssn,credit_card,address

# API authentication (production)
API_KEY_ENABLED=false
API_KEY=your_secret_api_key_here

# CORS settings
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ============================================================================
# Data Retention & Compliance
# ============================================================================

# Session retention (days)
SESSION_RETENTION_DAYS=90

# Routing log retention (days)
ROUTING_LOG_RETENTION_DAYS=365

# Ticket retention (days)
TICKET_RETENTION_DAYS=730

# Log file retention (days)
LOG_FILE_RETENTION_DAYS=30

# Enable automatic data cleanup
AUTO_CLEANUP_ENABLED=true

# Cleanup schedule (cron expression)
# Default: Run daily at 2 AM
CLEANUP_SCHEDULE=0 2 * * *

# ============================================================================
# Redis Configuration (Optional - for high-traffic scenarios)
# ============================================================================

# Enable Redis for session caching
REDIS_ENABLED=false

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Redis connection pool
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Cache TTL (seconds)
REDIS_CACHE_TTL=1800  # 30 minutes

# ============================================================================
# External Integrations (Optional)
# ============================================================================

# Twilio (for telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (for email notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Stripe (for payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar (for scheduling)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json

# ============================================================================
# Feature Flags
# ============================================================================

# Enable analytics dashboard
ANALYTICS_DASHBOARD_ENABLED=true

# Enable advanced debugging
DEBUG_MODE=false

# Enable request/response logging
LOG_REQUESTS=false

# Enable performance profiling
PROFILING_ENABLED=false

# ============================================================================
# Development Settings (Local Only)
# ============================================================================

# Auto-reload on code changes (development only)
RELOAD=true

# Use mock LLM for testing (development only)
USE_MOCK_LLM=false

# Seed test data on startup (development only)
SEED_TEST_DATA=false

# ============================================================================
# Production Optimizations
# ============================================================================

# Enable response compression
COMPRESSION_ENABLED=true

# Enable HTTP caching
HTTP_CACHE_ENABLED=true
HTTP_CACHE_MAX_AGE=300  # 5 minutes

# Enable database query optimization
DB_QUERY_OPTIMIZATION=true

# Enable prompt caching
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL=3600  # 1 hour

# ============================================================================
# Backup & Disaster Recovery
# ============================================================================

# Enable automated backups
BACKUP_ENABLED=false

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 3 * * *

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Backup destination
BACKUP_DESTINATION=s3://your-bucket/backups

# ============================================================================
# Email Notifications
# ============================================================================

# Enable email alerts
EMAIL_ALERTS_ENABLED=false

# Alert recipients (comma-separated)
ALERT_EMAIL_RECIPIENTS=ops@yourdomain.com,dev@yourdomain.com

# Alert on escalations
ALERT_ON_ESCALATION=true

# Alert on errors
ALERT_ON_ERROR=true

# Alert threshold (errors per minute)
ERROR_ALERT_THRESHOLD=10

# ============================================================================
# Webhooks
# ============================================================================

# Enable webhook notifications
WEBHOOKS_ENABLED=false

# Webhook URLs (comma-separated)
WEBHOOK_URLS=https://your-webhook-endpoint.com/callback

# Webhook events (comma-separated)
WEBHOOK_EVENTS=session.created,session.completed,session.escalated,booking.created

# Webhook retry attempts
WEBHOOK_RETRY_ATTEMPTS=3

# Webhook timeout (seconds)
WEBHOOK_TIMEOUT=10

# ============================================================================
# Custom Configuration
# ============================================================================

# Company/Business Information
COMPANY_NAME=Your Company Name
COMPANY_PHONE=(555) 555-5555
COMPANY_EMAIL=info@yourdomain.com
COMPANY_WEBSITE=https://yourdomain.com

# Business hours (for L3 general agent)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_TIMEZONE=America/Chicago

# Service area (for address validation)
SERVICE_AREA_ZIP_CODES=55401,55402,55403,55404,55405

# ============================================================================
# Notes
# ============================================================================
# 
# 1. Never commit .env to version control
# 2. Use strong, unique values for API keys and secrets
# 3. Adjust timeout values based on your LLM provider's response time
# 4. Monitor and adjust confidence thresholds based on accuracy metrics
# 5. Set SESSION_TTL_MINUTES based on typical call duration
# 6. Enable Redis for production deployments with >100 concurrent users
# 7. Configure CORS_ORIGINS carefully in production
# 8. Enable PII_MASKING_ENABLED in production
# 9. Set up proper monitoring with Sentry or similar tools
# 10. Review and adjust retention policies based on compliance requirements
#
# ============================================================================
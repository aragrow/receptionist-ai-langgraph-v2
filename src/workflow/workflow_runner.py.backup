# ==================== src/workflow/workflow_runner.py ====================
"""
Workflow Runner for AI Receptionist with 3-tier routing.
Command-line interface and programmatic runner for the workflow.
"""
import logging
import asyncio
import json
import sys
from typing import Dict, Any

from src.workflow.ai_receptionist_workflow import AIReceptionistWorkflow
from src.models.workflow_models import WorkflowState

logger = logging.getLogger(__name__)


class WorkflowRunner:
    """Runner for the AI Receptionist workflow with 3-tier routing."""
    
    def __init__(self):
        self.workflow = AIReceptionistWorkflow()
    
    async def run_workflow(self, call_data: Dict[str, Any]) -> Dict[str, Any]:
        """
        Run the workflow with call data.
        
        Args:
            call_data: Dictionary with caller_phone, speech_text, call_sid
        
        Returns:
            Dictionary with workflow results
        """
        try:
            await self.workflow.initialize()
            
            result = await self.workflow.process_call(call_data)
            
            # Extract key information for response
            response = {
                "success": result.processed,
                "caller_type": result.caller_type.value if result.caller_type else "unknown",
                "response": result.response_text or "No response generated",
                "error": result.error_message
            }
            
            # Add L1 intent if available
            if result.intent_l1:
                response["intent_l1"] = {
                    "name": result.intent_l1.name,
                    "confidence": result.intent_l1.confidence
                }
            
            # Add L2 intent if available
            if result.intent_l2:
                response["intent_l2"] = {
                    "name": result.intent_l2.name,
                    "confidence": result.intent_l2.confidence
                }
            
            # Add action results if available
            if result.action_result:
                response["action_result"] = result.action_result
            
            # Add next steps if available
            if result.next_steps:
                response["next_steps"] = result.next_steps
            
            # Add routing information
            response["routing"] = {
                "current_tier": result.current_tier,
                "current_agent": result.current_agent,
                "routing_history": result.routing_history
            }
            
            # Add escalation info if escalated
            if result.requires_human_escalation:
                response["escalation"] = {
                    "required": True,
                    "reason": result.escalation_reason,
                    "ticket_id": result.ticket_id
                }
            
            # Add clarification info if needed
            if result.awaiting_clarification:
                response["clarification"] = {
                    "question": result.clarification_question,
                    "attempt": result.clarification_count,
                    "missing_slots": result.missing_slots
                }
            
            # Add performance metrics
            if result.total_processing_time_ms:
                response["performance"] = {
                    "total_time_ms": result.total_processing_time_ms,
                    "turn_count": result.turn_count
                }
            
            logger.info(f"Workflow completed successfully: {result.call_sid}")
            return response
            
        except Exception as e:
            logger.error(f"Workflow execution failed: {e}")
            return {
                "success": False,
                "error": f"Workflow execution failed: {str(e)}",
                "response": "I apologize, but I'm experiencing technical difficulties."
            }
        
        finally:
            await self.workflow.cleanup()
    
    async def run_from_cli(self, args: list):
        """
        Run workflow from command line arguments.
        
        Args:
            args: Command line arguments
        """
        if len(args) < 2:
            print("Usage: python workflow_runner.py <caller_phone> [speech_text]")
            return
        
        call_data = {
            "caller_phone": args[1],
            "speech_text": args[2] if len(args) > 2 else "Hello, I need help",
            "call_sid": "cli_test_call"
        }
        
        print(f"\n{'='*80}")
        print(f"AI RECEPTIONIST WORKFLOW TEST")
        print(f"{'='*80}")
        print(f"Caller Phone: {call_data['caller_phone']}")
        print(f"Speech Text: {call_data['speech_text']}")
        print(f"{'='*80}\n")
        
        result = await self.run_workflow(call_data)
        
        print(f"\n{'='*80}")
        print(f"WORKFLOW RESULT")
        print(f"{'='*80}")
        print(json.dumps(result, indent=2, default=str))
        print(f"{'='*80}\n")


async def main():
    """Main entry point for CLI."""
    runner = WorkflowRunner()
    await runner.run_from_cli(sys.argv)


if __name__ == "__main__":
    asyncio.run(main())